{
  "name": "@nulvless/nulvless-js",
  "version": "0.1.6",
  "description": "Official JavaScript SDK for the Nulvless platform",
  "keywords": [
    "nulvless",
    "auth",
    "authentication",
    "oauth",
    "oidc",
    "mfa",
    "sdk",
    "typescript"
  ],
  "homepage": "https://github.com/nulvless/nulvless-js#readme",
  "bugs": {
    "url": "https://github.com/nulvless/nulvless-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nulvless/nulvless-js.git"
  },
  "license": "MIT",
  "author": "Nulvless",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/jest": "^30.0.0",
    "eslint": "^10.13.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0"
  }
}
